# Optional. You can instead paste your key in-game: Settings (O) → Jev → "TypeSafe API key".
# A key set in the game wins over this file. Either way it is only read by your local dev
# server (server/jevProxy.ts) and never ends up in the browser bundle. Do NOT prefix with VITE_.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
